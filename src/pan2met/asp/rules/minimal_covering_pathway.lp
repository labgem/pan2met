% Find a minimal set of pathways
% given a catalyzed reactome (i.e., a set of reactions with identified associated enzyme)
% such that all reactions of the reactome are covered
% and such that a minimal set of reaction hole is selected.

% A pathway is represented as pathway/1.
% A reaction is represented as reaction/1.
% When a reaction R is in pathway P the atom pathway_reaction(P, R) holds.
% When a reaction R is for sure present in the reactome,
% the atom reactome(R) holds.

% infer_present_pathway(P) is true if pathway P is inferred to be present

potential_pathway(P) :- pathway(P) , reactome(R) , pathway_reaction(P, R).
% achieved: there must be at least one reaction of the pathway that is present in the reactome
% to have a chance of being selected in the metabolism.
% This rule is written to try to limit the search space of generated by choice rule below,
% instead of writting directly:
% { infer_present_pathway(P) : pathway(P) }.

{ infer_present_pathway(P): potential_pathway(P) }.
% achieved: a subset of all pathways is chosen

covered_reaction(R) :- pathway_reaction(P, R) , infer_present_pathway(P).
% achieved: identify the subset of the template metabolic database reactions set
% that is covered by the selected set of pathway.

:- reactome(R) , not covered_reaction(R).
% achieved: when a reaction is in the reactome, it must also be covered by the selected set of pathways.

count_present_pathways(N) :- N = #count { P: infer_present_pathway(P) }.
% achieved: N is the number of pathway in the infered metabolism

pathway_hole(P, H) :- infer_present_pathway(P) , pathway_reaction(P, H) , not reactome(H).
% achieved: H is a reaction of pathway P that is not present
% in the known reactome of target organism

count_pathway_holes(N) :- N = #count { H: pathway_hole(P, H) }.
% achieved: N is the count of pathway holes in the inferred metabolism.

#minimize { 1@100, N: count_present_pathways(N) }.
% achieved: among possible chosen set of pathways, the smallest is retained

#minimize { 1@75, N: count_pathway_holes(N) }.
% achieved: also minimize, with less weight the number of pathway holes
%
% the optimisation strategy might be interesting to tune with option --opt-strategy=bb,hier
% for Model-guided optimisation, with tactics hierarchical (highest priority criteria first) descent.
% cf. https://stackoverflow.com/a/77288102

% ---

#show count_present_pathways/1.
#show infer_present_pathway/1.
